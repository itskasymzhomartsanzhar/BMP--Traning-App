# Скопируйте в .env рядом с docker-compose.yml и заполните.
#   cp .env.example .env

# --- Обязательные ---

# Django. Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Пароль Postgres (создаётся при первом запуске)
POSTGRES_PASSWORD=

# Почта для Let's Encrypt (уведомления об истечении сертификата)
CERTBOT_EMAIL=sanzhar.kasymzhomart@gmail.com

# --- Telegram ---

# Токен бота: вход через мини-апп и виджет не заработают без него
TELEGRAM_BOT_TOKEN=

# Username бота без @ — кнопка «Войти через Telegram» на сайте.
# Не забудьте /setdomain в BotFather → tresfit.ru
VITE_TG_BOT_USERNAME=

# --- Опциональные ---

# Автосоздание администратора при первом запуске (вход в /admin по этим данным)
DJANGO_SUPERUSER_TG_ID=1
DJANGO_SUPERUSER_PASSWORD=

# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# База (менять не обязательно)
POSTGRES_DB=tres
POSTGRES_USER=tres
